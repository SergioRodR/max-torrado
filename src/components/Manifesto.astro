---
// Las palabras entre | | se resaltan en dorado. El texto se ilumina palabra por palabra con el scroll.
const text = 'No hacemos looks en serie. Leemos tu cabello, escuchamos cómo vives y diseñamos un resultado que se ve |increíble| hoy y crece |bien| en seis semanas.';
const words = text.split(/(\|[^|]+\|)|\s+/).filter(Boolean).map((w) => (w.startsWith('|') ? { w: w.slice(1, -1), gold: true } : { w, gold: false }));
---
<section class="manifesto wrap" id="manifesto">
  <span class="eyebrow">La casa</span>
  <p id="mText">{words.map((x, i) => <><span class={x.gold ? 'w gold' : 'w'}>{x.w}</span>{i < words.length - 1 ? ' ' : ''}</>)}</p>
  <div class="sig"><span class="logo-foil"></span><span>Fundado por Max Torrado</span></div>
</section>
<script>
  import { $, $$, RM } from '../scripts/dom.js';
  const mt = $('#mText');
  const words = $$('.w', mt);
  function fill() {
    const r = mt.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.35)));
    const n = Math.round(p * words.length);
    words.forEach((w, i) => w.classList.toggle('on', i < n || RM));
  }
  addEventListener('scroll', fill, { passive: true });
  fill();
</script>
