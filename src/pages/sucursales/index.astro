---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Branches from '../../components/Branches.astro';
import CtaBand from '../../components/CtaBand.astro';
import { crumbsLD } from '../../lib/schema.js';
import { u } from '../../lib/url.js';
const abs = (p) => new URL(u(p), Astro.site).href;
---
<Base title="Sucursales en Moderna y Narvarte" description="Max Torrado Salón tiene dos sucursales en la alcaldía Benito Juárez, CDMX: colonia Moderna y Narvarte. Horarios, teléfonos y cómo llegar." jsonld={crumbsLD([['Inicio', abs('/')], ['Sucursales', abs('/sucursales/')]])}>
  <PageHead crumbs={[['Inicio', '/'], ['Sucursales']]} eyebrow="Sucursales" title="Dos casas,<br>el mismo <em>estándar</em>." lede="Elige la sucursal que te quede más cerca: el mismo equipo, el mismo menú y la misma atención." />
  <Branches showHead={false} />
  <CtaBand />
</Base>
